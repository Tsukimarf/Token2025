# --- App ---
APP_NAME="Token2025 API"
ENV=development
DEBUG=true

# --- Database ---
# SQLite needs no setup (default). For Postgres/MySQL, point this at your DB.
DATABASE_URL=sqlite:///./app.db

# --- Security / JWT ---
SECRET_KEY=CHANGE_ME_IN_PRODUCTION
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- CORS ---
CORS_ORIGINS=*

# --- Live BLD price (src/price.py) ---
# Leave BLD_CONTRACT_ADDRESS empty until BLD is actually deployed/listed.
# GET /price/live will return status="pre_launch" (no fake price) until then.
BLD_CONTRACT_ADDRESS=
BLD_DEX_PAIR_ADDRESS=
PRICE_CACHE_SECONDS=30
