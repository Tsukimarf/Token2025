            { "name": "amount", "type": "u64",       "index": false }
          ]
        }
      ],
      "constants": [
        { "name": "REWARD_PER_NFT_PER_MONTH", "type": "u64", "value": "50000000000000" }
      ]
    },

    "bld_burn_claim": {
      "version": "0.1.0",
      "name":    "bld_burn_claim",
      "accounts": [
