          ]
        }
      ],
      "constants": [
        { "name": "BLD_PER_BURN", "type": "u64", "value": "5000000000000000" }
      ]
    }
  },

  "abi": {
    "note": "EVM-style ABI reference for cross-chain / educational purposes. Solana uses IDL above.",
    "bld_token": [
      { "type": "function", "name": "initialize",           "inputs": [{"name":"totalSupply","type":"uint64"},{"name":"decimals","type":"uint8"}],  "outputs": [], "stateMutability": "nonpayable" },
      { "type": "function", "name": "mintTo",               "inputs": [{"name":"amount","type":"uint64"}],                                           "outputs": [], "stateMutability": "nonpayable" },
      { "type": "function", "name": "transfer",             "inputs": [{"name":"to","type":"address"},{"name":"amount","type":"uint64"}],             "outputs": [{"name":"","type":"bool"}], "stateMutability": "nonpayable" },
      { "type": "function", "name": "disableMintAuthority", "inputs": [],                                                                            "outputs": [], "stateMutability": "nonpayable" },
      { "type": "function", "name": "balanceOf",            "inputs": [{"name":"account","type":"address"}],                                         "outputs": [{"name":"","type":"uint64"}], "stateMutability": "view" },
      { "type": "function", "name": "totalSupply",          "inputs": [],                                                                            "outputs": [{"name":"","type":"uint64"}], "stateMutability": "view" },
      { "type": "event",    "name": "Transfer",             "inputs": [{"name":"from","type":"address","indexed":true},{"name":"to","type":"address","indexed":true},{"name":"amount","type":"uint64","indexed":false}], "anonymous": false },
      { "type": "event",    "name": "TokenInitialized",     "inputs": [{"name":"mint","type":"address","indexed":true},{"name":"totalSupply","type":"uint64","indexed":false},{"name":"decimals","type":"uint8","indexed":false}], "anonymous": false }
    ],
    "bld_staking": [
      { "type": "function", "name": "stake",         "inputs": [{"name":"nftMint","type":"address"}], "outputs": [], "stateMutability": "nonpayable" },
      { "type": "function", "name": "unstake",       "inputs": [{"name":"nftMint","type":"address"}], "outputs": [], "stateMutability": "nonpayable" },
      { "type": "function", "name": "claimReward",   "inputs": [{"name":"nftMint","type":"address"}], "outputs": [], "stateMutability": "nonpayable" },
      { "type": "function", "name": "pendingReward", "inputs": [{"name":"nftMint","type":"address"}], "outputs": [{"name":"","type":"uint64"}], "stateMutability": "view" },
      { "type": "event",    "name": "Staked",        "inputs": [{"name":"owner","type":"address","indexed":true},{"name":"nftMint","type":"address","indexed":true},{"name":"stakedAt","type":"int64","indexed":false}], "anonymous": false },
      { "type": "event",    "name": "RewardClaimed", "inputs": [{"name":"owner","type":"address","indexed":true},{"name":"amount","type":"uint64","indexed":false}], "anonymous": false }
    ],
    "bld_burn_claim": [
      { "type": "function", "name": "burnAndClaim", "inputs": [{"name":"nftMint","type":"address"}], "outputs": [], "stateMutability": "nonpayable" },
      { "type": "event",    "name": "BurnClaimed",  "inputs": [{"name":"burner","type":"address","indexed":true},{"name":"nftMint","type":"address","indexed":true},{"name":"bldAmount","type":"uint64","indexed":false}], "anonymous": false }
    ]
  },

  "api": {
    "base_url":   "https://api.bld.finance",
    "version":    "v1",
    "auth":       "Bearer JWT",
    "rate_limit": 300,
    "rate_unit":  "req/min",
    "endpoints": [
      { "module": "token",   "method": "GET",  "path": "/v1/token/info",             "description": "Token metadata — name, symbol, supply, contract address", "auth_required": true,  "params": [] },
      { "module": "token",   "method": "GET",  "path": "/v1/token/supply",           "description": "Supply breakdown — total, circulating, burned, locked",   "auth_required": true,  "params": [] },
      { "module": "token",   "method": "GET",  "path": "/v1/token/balance/{wallet}", "description": "BLD balance for a Solana wallet",                         "auth_required": true,  "params": [{"name":"wallet","in":"path","type":"string","required":true}] },
      { "module": "token",   "method": "POST", "path": "/v1/token/transfer",         "description": "Send BLD — requires wallet signature",                    "auth_required": true,  "params": [{"name":"from","in":"body","type":"string","required":true},{"name":"to","in":"body","type":"string","required":true},{"name":"amount","in":"body","type":"integer","required":true},{"name":"signature","in":"body","type":"string","required":true}] },
      { "module": "nft",     "method": "GET",  "path": "/v1/nft/collection",         "description": "Skull Series collection metadata",                        "auth_required": true,  "params": [] },
      { "module": "nft",     "method": "GET",  "path": "/v1/nft/{mint_address}",     "description": "Single NFT metadata — rarity, traits, owner",             "auth_required": true,  "params": [{"name":"mint_address","in":"path","type":"string","required":true}] },
      { "module": "nft",     "method": "GET",  "path": "/v1/nft/wallet/{wallet}",    "description": "NFTs owned by wallet — filter by rarity or staked",       "auth_required": true,  "params": [{"name":"wallet","in":"path","type":"string","required":true},{"name":"staked","in":"query","type":"boolean","required":false},{"name":"rarity","in":"query","type":"string","required":false}] },
      { "module": "nft",     "method": "POST", "path": "/v1/nft/mint",               "description": "Mint skull NFT via Candy Machine guard",                  "auth_required": true,  "params": [{"name":"payer","in":"body","type":"string","required":true},{"name":"signature","in":"body","type":"string","required":true},{"name":"whitelist_token","in":"body","type":"string","required":false}] },
      { "module": "staking", "method": "POST", "path": "/v1/staking/stake",          "description": "Stake NFT into StakeAccount PDA",                        "auth_required": true,  "params": [{"name":"wallet","in":"body","type":"string","required":true},{"name":"nft_mint","in":"body","type":"string","required":true},{"name":"signature","in":"body","type":"string","required":true}] },
      { "module": "staking", "method": "POST", "path": "/v1/staking/unstake",        "description": "Unstake NFT — auto-claims pending BLD",                   "auth_required": true,  "params": [{"name":"wallet","in":"body","type":"string","required":true},{"name":"nft_mint","in":"body","type":"string","required":true},{"name":"signature","in":"body","type":"string","required":true}] },
      { "module": "staking", "method": "GET",  "path": "/v1/staking/pending/{wallet}","description": "Pending BLD rewards per wallet",                        "auth_required": true,  "params": [{"name":"wallet","in":"path","type":"string","required":true}] },
      { "module": "staking", "method": "POST", "path": "/v1/staking/claim",          "description": "Claim rewards without unstaking",                        "auth_required": true,  "params": [{"name":"wallet","in":"body","type":"string","required":true},{"name":"nft_mints","in":"body","type":"array","required":true},{"name":"signature","in":"body","type":"string","required":true}] },
      { "module": "burn",    "method": "POST", "path": "/v1/burn/claim",             "description": "Burn skull NFT → receive 5M BLD — irreversible",          "auth_required": true,  "params": [{"name":"wallet","in":"body","type":"string","required":true},{"name":"nft_mint","in":"body","type":"string","required":true},{"name":"signature","in":"body","type":"string","required":true}] },
      { "module": "burn",    "method": "GET",  "path": "/v1/burn/history/{wallet}",  "description": "Burn history for a wallet",                               "auth_required": true,  "params": [{"name":"wallet","in":"path","type":"string","required":true}] },
      { "module": "burn",    "method": "GET",  "path": "/v1/burn/vault",             "description": "Reward vault balance and remaining claims",               "auth_required": false, "params": [] }
    ],
    "status_codes": {
      "200": "OK",
      "400": "Bad request — invalid params or insufficient balance",
      "401": "Unauthorized — invalid or missing JWT",
      "403": "Forbidden — signature verification failed",
      "404": "Not found",
      "409": "Conflict — duplicate state (already staked, etc.)",
      "500": "Internal server error — vault insufficient or program error"
    }
  },

