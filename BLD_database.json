      ],
      "events": [
        {
          "name": "Staked",
          "fields": [
            { "name": "owner",    "type": "publicKey", "index": true  },
            { "name": "nftMint",  "type": "publicKey", "index": true  },
            { "name": "stakedAt", "type": "i64",       "index": false }
          ]
        },
        {
          "name": "RewardClaimed",
          "fields": [
