          ]
        },
        {
          "name": "mintNft",
          "accounts": [
            { "name": "candyMachine",  "isMut": true,  "isSigner": false },
            { "name": "mint",          "isMut": true,  "isSigner": true  },
            { "name": "metadata",      "isMut": true,  "isSigner": false },
